# Server port (PM2 ecosystem reads this).
PORT=4100

# Google Agent Platform reasoning engine (the cfs-product-listing-agent).
AGENT_ENDPOINT_URL=https://us-east1-aiplatform.googleapis.com/v1/projects/cfsagents/locations/us-east1/reasoningEngines/6189142156658081792:query
AGENT_PROJECT=cfsagents

# One of the two auth modes — pick whichever fits the host.
# 1) Service-account JSON inlined (recommended for the production box):
#    GOOGLE_AGENT_CREDENTIALS_JSON='{"type":"service_account",...}'
# 2) Application Default Credentials (set GOOGLE_APPLICATION_CREDENTIALS to a
#    service account key path) or `gcloud auth application-default login`.
GOOGLE_AGENT_CREDENTIALS_JSON=
